@startuml
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Calibri
skinparam defaultFontSize 11
skinparam nodesep 30
skinparam ranksep 55
skinparam shadowing false

skinparam rectangle {
  BackgroundColor #FFEBEE
  BorderColor #C62828
  BorderThickness 1.5
  FontSize 11
}
skinparam arrow {
  Color #B71C1C
  FontSize 10
}

